# Copie este arquivo para ".env" na raiz do projeto e preencha com os valores
# reais do projeto Supabase (Project Settings > API no painel do Supabase).
#
# PowerShell:
#   Copy-Item .env.example .env
#
# Depois de criar/editar o .env, reinicie o Metro com cache limpo:
#   npx expo start --clear
#
# Sem este arquivo preenchido, o app cai num host placeholder inexistente e
# o login com Google falha com "Safari não pode abrir a página porque não
# pode se conectar ao servidor" (ver lib/supabase.ts).

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
